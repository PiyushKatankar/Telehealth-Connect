# Copy to .env and adjust. Never commit the real .env file.

# development | testing | production
FLASK_CONFIG=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-me

# Leave unset for the SQLite quick start, or point at PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://telehealth:telehealth@localhost:5432/telehealth

# HTTP port for the dev server (run.py)
PORT=5000

# Uncomment when running Flask-SocketIO with more than one worker process:
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0
